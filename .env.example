# Copy this file to .env before running docker compose
DJANGO_SECRET_KEY=change-me-to-a-long-random-string
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=*
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Database used INSIDE Docker (separate from any PostgreSQL installed on your PC)
# The "db" container is created with these same values, so they always match
POSTGRES_DB=ughe_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Predefined login credentials
APP_USERNAME=ughe
APP_PASSWORD=Ughe@2026
ADMIN_USERNAME=admin
ADMIN_PASSWORD=Admin@2026
